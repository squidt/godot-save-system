[sub_resource type="GDScript" id="GDScript_eigt2"]
resource_name = "Transit"
script/source = "extends Node3D

@export var transit_name: String
@export var transit_point: Node3D

func get_transit_point() -> Transform3D:
	return transit_point.global_transform if transit_point else global_transform.translated_local(Vector3(0.0, 0.0, -1.0))
"

